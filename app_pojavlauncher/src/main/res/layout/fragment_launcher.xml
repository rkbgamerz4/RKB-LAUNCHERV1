
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070C">

    <!-- Main content area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rkb_main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toEndOf="@id/rkb_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Header -->
        <TextView
            android:id="@+id/rkb_brand_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="RKB LAUNCHER"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/rkb_brand_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="PLAY  •  EXPLORE  •  CREATE"
            android:textColor="#96A8BE"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rkb_brand_title" />

        <!-- Social buttons: keep original IDs -->
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#09121E"
            android:drawableStart="@drawable/ic_px_book"
            android:text="@string/mcl_tab_wiki"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/social_media_button"
            app:layout_constraintTop_toBottomOf="@id/rkb_brand_subtitle" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/social_media_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="#09121E"
            android:drawableStart="@drawable/ic_social_media"
            android:text="@string/mcl_button_social_media"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/news_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/news_button" />

        <!-- Instance panel -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rkb_instance_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#070D16"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/news_button">

            <TextView
                android:id="@+id/rkb_instance_heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="MINECRAFT INSTANCE"
                android:textColor="#00A8FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Original profile/version selector -->
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                android:textColor="#FFFFFF"
                app:drawableEndSize="@dimen/padding_heavy"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_36sdp"
                app:drawableEndPadding="@dimen/_1sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
                app:layout_constraintTop_toBottomOf="@id/rkb_instance_heading" />

            <!-- Original profile edit button -->
            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Edit profile"
                android:padding="10dp"
                android:src="@drawable/ic_px_edit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/mc_version_spinner"
                app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Player / account panel -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rkb_account_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#09121E"
            android:padding="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rkb_instance_panel">

            <TextView
                android:id="@+id/rkb_player_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PLAYER ACCOUNT"
                android:textColor="#00A8FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/rkb_account_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Current Minecraft account"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rkb_player_label" />

            <TextView
                android:id="@+id/rkb_skin_placeholder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Account and skin preview"
                android:textColor="#96A8BE"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rkb_account_name" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Existing launcher utilities -->
        <ScrollView
            android:id="@+id/rkb_utilities_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rkb_account_panel"
            app:layout_constraintBottom_toTopOf="@id/play_button">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/custom_control_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_px_gamepad"
                    android:text="@string/mcl_option_customcontrol"
                    android:textColor="#FFFFFF" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_jar_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_px_java_run"
                    android:text="@string/main_install_jar_file"
                    android:textColor="#FFFFFF" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/share_logs_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_px_sharelog"
                    android:text="@string/main_share_logs"
                    android:textColor="#FFFFFF" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_px_folder"
                    android:text="@string/mcl_button_open_directory"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

        <!-- Original launch action -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#00A8FF"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textColor="#05070C"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Persistent left sidebar -->
    <LinearLayout
        android:id="@+id/rkb_sidebar"
        android:layout_width="64dp"
        android:layout_height="0dp"
        android:background="#070D16"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/rkb_sidebar_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#09121E"
            android:gravity="center"
            android:text="RKB"
            android:textColor="#00A8FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#183047" />

        <!-- Sidebar items are visual navigation placeholders -->
        <TextView
            android:id="@+id/rkb_nav_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#10283A"
            android:gravity="center"
            android:text="H"
            android:textColor="#00A8FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:contentDescription="Home" />

        <TextView
            android:id="@+id/rkb_nav_cursor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="C"
            android:textColor="#96A8BE"
            android:textSize="18sp"
            android:contentDescription="Cursor Studio" />

        <TextView
            android:id="@+id/rkb_nav_mods"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="M"
            android:textColor="#96A8BE"
            android:textSize="18sp"
            android:contentDescription="Mod on/off" />

        <TextView
            android:id="@+id/rkb_nav_control"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="K"
            android:textColor="#96A8BE"
            android:textSize="18sp"
            android:contentDescription="Control" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#183047" />

        <TextView
            android:id="@+id/rkb_nav_about"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="A"
            android:textColor="#96A8BE"
            android:textSize="18sp"
            android:contentDescription="About" />

        <TextView
            android:id="@+id/rkb_nav_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="S"
            android:textColor="#96A8BE"
            android:textSize="18sp"
            android:contentDescription="Settings" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
