<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog pop-in: fade + scale from 94% (video: ~220 ms, decelerate). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:duration="200" android:fromAlpha="0.0" android:toAlpha="1.0" />
    <scale
        android:duration="220"
        android:fromXScale="0.94" android:toXScale="1.0"
        android:fromYScale="0.94" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
